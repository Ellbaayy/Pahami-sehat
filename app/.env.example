# Salin jadi .env lalu isi key-nya.
# Dapatkan key di https://kenari.id  (mode file harus 600)
KENARI_API_KEY=kn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KENARI_BASE_URL=https://kenari.id/v1
KENARI_MODEL=deepseek-v4-1-flash
PORT=8787
MAX_TOKENS=1500
TEMPERATURE=0.3

# --- suara (text-to-speech) ---
# Suara dibuat lewat dua jalur, dicoba berurutan:
#   1. Kenari POST /audio/speech  -> HTTPS biasa, jalan juga di serverless Vercel
#   2. msedge-tts                 -> WebSocket, HANYA jalan di server biasa
# Di Vercel, jalur 2 tidak mungkin hidup, jadi jalur 1 yang wajib berfungsi.
# Isi `KENARI_TTS=0` untuk mematikan jalur 1 (mis. saat menguji jalur 2).
# KENARI_TTS_MODEL=gemini-3-1-flash-tts
# KENARI_TTS_VOICE=Kore

